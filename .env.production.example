# Modèle de configuration pour une mise en ligne.
# Copiez-le en .env sur le serveur (/srv/sports/.env), puis remplissez
# chaque valeur marquée À REMPLIR.

APP_NAME="Séance"
APP_ENV=production
# À REMPLIR : php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://sports.vallau.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# Domaine de l'application : c'est le Traefik du serveur qui obtient son certificat.
APP_DOMAIN=sports.vallau.com

# Derrière le Traefik du serveur, l'application doit faire confiance aux
# en-têtes X-Forwarded-* venus du réseau « proxy », dont le sous-réseau est fixé
# à la création : 172.30.0.0/24.
TRUSTED_PROXIES=172.30.0.0/24

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sports
DB_USERNAME=sports
# À REMPLIR : openssl rand -base64 24
DB_PASSWORD=
# À REMPLIR : openssl rand -base64 24
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
# Une séance dure souvent plus de deux heures : la session tient la journée.
SESSION_LIFETIME=720
# Le cookie de session ne doit jamais circuler en clair.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Inscriptions libres ; à passer à false une fois ses proches inscrits.
SPORT_REGISTRATION_OPEN=true

# E-mails (mot de passe oublié) — boîte IONOS du domaine, l'expéditeur DOIT être cette boîte.
MAIL_MAILER=smtp
MAIL_HOST=smtp.ionos.fr
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=vallau@vallau.com
# À REMPLIR : mot de passe de la boîte
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=vallau@vallau.com
MAIL_FROM_NAME="${APP_NAME}"
